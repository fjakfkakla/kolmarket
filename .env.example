# Copier en .env.local pour le dev. En production : Railway → Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement, ne jamais exposer
SUPABASE_SERVICE_ROLE_KEY=

# Signature des cookies de session. Obligatoire en production : openssl rand -hex 32
SESSION_SECRET=
# Adresse publique du site (écrite dans le message signé par le wallet)
APP_URL=
# devnet (défaut) ou mainnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
