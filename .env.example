# Copier en .env.local pour le dev. En production : Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement, ne jamais exposer
SUPABASE_SERVICE_ROLE_KEY=

# Signature des cookies de session. Obligatoire en production : openssl rand -hex 32
SESSION_SECRET=
# Adresse(s) publique(s) du site, séparées par des virgules. Les domaines Vercel sont acceptés d'office.
APP_URL=
# devnet (défaut) ou mainnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Dépôts USDC (Solana)
ALCHEMY_API=
# Adresse publique du coffre
VAULT_ADDRESS=
# Clé privée du wallet qui paie les frais réseau (quelques SOL seulement). Secret.
FEE_PAYER_SECRET_KEY=
# Signing key du webhook Alchemy « Address Activity » sur le coffre. Secret.
ALCHEMY_WEBHOOK_SIGNING_KEY=
# Protège /api/cron/sync : openssl rand -hex 16
CRON_SECRET=
